# Apache settings for one.com.

# Always use HTTPS: send http:// visitors to the same address on https:// (one.com's own recipe).
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Older servers don't know AVIF and would send it as a download, which breaks the photo.
AddType image/avif .avif

# File names aren't versioned, so keep caches short: pages are always revalidated, everything
# else for an hour. A deploy is visible to returning visitors within the hour at the latest.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js|avif|jpg|png)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>
